# Server-only Gemini API key (https://aistudio.google.com/apikey)
# NEVER prefix this with NEXT_PUBLIC_ — it must stay on the server.
GEMINI_API_KEY=

# Supabase project credentials (safe for the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Never add SUPABASE_SERVICE_ROLE_KEY to this project — RLS is the boundary.

# Optional override of the primary Gemini model
# GEMINI_MODEL=gemini-3.5-flash

# Optional real-time exchange-rate provider key (ExchangeRate-API).
# Server-only — NEVER prefix with NEXT_PUBLIC_. Without it, currency answers
# degrade to a safe "not configured" message instead of guessing rates.
# EXCHANGE_RATE_API_KEY=

# Real-time weather uses Open-Meteo — a free, keyless API (no env var needed).
# It resolves cities via geocoding and returns current/forecast conditions.
# Requires outbound network to api.open-meteo.com and geocoding-api.open-meteo.com.

# ---- Phase 6C: text→image generation (all values server-only) ---------------
# Optional override of the primary Gemini image model.
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Hugging Face token for the image fallback provider. Server-only — NEVER
# prefix with NEXT_PUBLIC_. If unset, the fallback provider is treated as
# unauth config and NEVER reached — Gemini-alone requests still work.
# HF_TOKEN=

# Optional override of the Hugging Face image model. Current default is served
# on the Inference Providers router via provider "nscale".
# HF_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell

# Optional router provider. Default "nscale" (serves FLUX.1-schnell through
# HF-token Router billing; this is the provider HF "auto" routing selects for
# the model). Set to "hf-inference" to use the {inputs} tasks contract instead
# (requires a model served by hf-inference, e.g.
# stabilityai/stable-diffusion-3-medium-diffusers).
# HF_INFERENCE_PROVIDER=nscale

# Optional override of the Inference Providers router base URL.
# HF_INFERENCE_BASE_URL=https://router.huggingface.co

# ---- Phase 6D: Hugging Face image-EDIT fallback (server-only) --------------
# The same HF token above powers edits. Editing is a DIFFERENT HF service: the
# router's image-to-image models, served by fal-ai / replicate / wavespeed —
# never nscale (text-to-image only for generation). The edit request always
# carries the validated source image bytes as a data URL (never a text-only
# re-render). HF is reached only when Gemini fails with an ELIGIBLE error
# (timeout / rate limit / unavailable / malformed response); safety blocks and
# auth/config failures never fall back.

# Optional edit model. Default Qwen/Qwen-Image-Edit; alternative (same var):
# black-forest-labs/FLUX.1-Kontext-dev.
# HF_IMAGE_EDIT_MODEL=Qwen/Qwen-Image-Edit

# Optional edit router provider (default "fal-ai"; also: "replicate",
# "wavespeed"). Generation keeps its own HF_INFERENCE_PROVIDER (nscale) — the
# two are independent and never share a router provider.
# HF_IMAGE_EDIT_PROVIDER=fal-ai

# Optional tuning of the queue-style poll cadence/ceiling (defaults 500 ms /
# 90 polls → ~45 s ceiling, inside the 60 s service budget).
# HF_IMAGE_EDIT_POLL_MS=500
# HF_IMAGE_EDIT_MAX_POLLS=90

# Comma-separated provider order; server-side only — the browser can never
# request a specific provider. Default (unset): gemini,huggingface.
# IMAGE_PROVIDERS=gemini,huggingface
